{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban-custom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  "triggers": {
    // daily report, Mon–Fri only (the scheduled handler still skips weekends as a safeguard)
    "crons": ["0 7 * * 1-5"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENROUTER_MODEL": "z-ai/glm-5.3"
  }
  // API_KEY: set a secret for production with `wrangler secret put API_KEY`,
  // and a local value in .dev.vars (see .dev.vars.example) for `wrangler dev`.
}
