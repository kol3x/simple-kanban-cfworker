{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban-custom",
  "main": "src/worker.ts",
  // only the real domain serves traffic; the preview URL is disabled
  "workers_dev": false,
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  "triggers": {
    // daily report, Mon–Fri only. NB: Cloudflare cron triggers use Quartz numbering
    // for weekdays (1 = Sunday), so Mon–Fri is 2-6 — NOT 1-5 as in classic cron.
    // The scheduled handler still skips weekends as a safeguard.
    "crons": ["0 7 * * 2-6"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENROUTER_MODEL": "z-ai/glm-5.3"
  }
  // API_KEY: set a secret for production with `wrangler secret put API_KEY`,
  // and a local value in .dev.vars (see .dev.vars.example) for `wrangler dev`.
}
